# Standalone Flask digit-recognition backend. Restart Vite after changing it.
# The prediction API also supports VITE_DYSCALCULIA_ML_URL for compatibility.
VITE_DYSCALCULIA_API_URL=http://localhost:4001
VITE_DYSCALCULIA_ML_URL=http://localhost:4002

# Working Memory endpoints are relative to this route prefix.
# Use the same value in the Vercel frontend project's environment variables.
VITE_WORKINGMEMORY_API_URL=https://working-memory-backend-f7qu.vercel.app/api/working-memory
